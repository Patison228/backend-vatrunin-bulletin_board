@base = http://localhost:8000

### Сервис жив?
GET {{base}}/health

### Создать объявление 1 (Активное)
POST {{base}}/api/ads
Content-Type: application/json

{
    "title": "Продам велосипед",
    "price": 15000
}

### Создать объявление 2 
POST {{base}}/api/ads
Content-Type: application/json

{
    "title": "Продам ноутбук",
    "price": 50000
}

### сделать проданным 2 обьяв.
PATCH {{base}}/api/ads/2
Content-Type: application/json

{ "status": "sold" }

### Список всех объяв.
GET {{base}}/api/ads

### Список только активных
GET {{base}}/api/ads?status=active&limit=5&offset=0

### Оставить отклик на активное объявление (id=1) - 201
POST {{base}}/api/ads/1/responses
Content-Type: application/json

{
    "name": "Иван",
    "phone": "+79991234567",
    "message": "Еще продаете?"
}

### Оставить отклик на проданное объявление (id=2) - 409
POST {{base}}/api/ads/2/responses
Content-Type: application/json

{
    "name": "Мария",
    "phone": "+79997654321",
    "message": "Куплю!"
}

### Получить отклики объявления 1
GET {{base}}/api/ads/1/responses

### Статистика
GET {{base}}/api/stats

### Удалить объявление 1
DELETE {{base}}/api/ads/1

### Проверка 404
GET {{base}}/api/ads/1

### Сломанный JSON (400)
POST {{base}}/api/ads
Content-Type: application/json

{ "title":

### пустой title (400)
POST {{base}}/api/ads
Content-Type: application/json

{ "title": "", "price": 100 }